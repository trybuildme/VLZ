# State enum
class libvlc_state_t:
    NothingSpecial = 0
    Opening = 1
    Buffering = 2
    Playing = 3
    Paused = 4
    Stopped = 5
    Ended = 6
    Error = 7

libvlc.libvlc_media_player_get_state.argtypes = [libvlc_media_player_t]
libvlc.libvlc_media_player_get_state.restype = ctypes.c_int


class VideoWidget(QFrame):
    """Widget that hosts the embedded video"""
    
    def __init__(self, parent=None):
        super().__init__(parent)
        self.setFrameStyle(QFrame.Shape.NoFrame)
        self.setStyleSheet("background-color: #000;")
        self.setMinimumSize(320, 180)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Expanding)
        self.setMouseTracking(True)
        self.setAttribute(Qt.WidgetAttribute.WA_NativeWindow, True)
        self.setAttribute(Qt.WidgetAttribute.WA_OpaquePaintEvent, True)
        self._window_id = None
        
    def showEvent(self, event):
        super().showEvent(event)
        # Get native window ID
        self._window_id = int(self.winId())
            
    def get_window_id(self):
        return self._window_id


class VlzController(QObject):
    """Controls libvlc directly for embedded playback"""
    
    state_changed = pyqtSignal(int)
    time_changed = pyqtSignal(int, int)  # current, total (ms)
    volume_changed = pyqtSignal(int)
    track_changed = pyqtSignal(str, int, int)  # name, index, total
    error_occurred = pyqtSignal(str)
    queue_finished = pyqtSignal()
    
    def __init__(self, video_widget: VideoWidget):
        super().__init__()
        self.video_widget = video_widget
        self.instance = None
        self.media_player = None
        self.queue: List[str] = []
        self.current_index = 0
        self.queue_total = 0
        self.current_volume = 50
        self._poll_timer = QTimer()
        self._poll_timer.timeout.connect(self._poll_status)
        
    def initialize(self):
        """Initialize libvlc instance"""
        if self.instance:
            return
            
        args = ["--no-ignore-config", "--video-title=VLZ Media Player"]
        argc = len(args)
        argv = (ctypes.c_char_p * argc)()
        for i, arg in enumerate(args):
            argv[i] = arg.encode('utf-8')
            
        self.instance = libvlc.libvlc_new(argc, argv)
        if not self.instance:
            self.error_occurred.emit("Failed to initialize libvlc")
            return False
        return True
        
    def play_media(self, path: str):
        """Play a media file/URL"""
        if not self.instance:
            if not self.initialize():
                return False
                
        # Release current media player if exists
        if self.media_player:
            libvlc.libvlc_media_player_stop(self.media_player)
            libvlc.libvlc_media_player_release(self.media_player)
            
        # Create media
        if "://" in path:
            media = libvlc.libvlc_media_new_location(self.instance, path.encode('utf-8'))
        else:
            media = libvlc.libvlc_media_new_path(self.instance, path.encode('utf-8'))
            
        if not media:
            self.error_occurred.emit(f"Failed to create media for {path}")
            return False
            
        # Create media player
        self.media_player = libvlc.libvlc_media_player_new_from_media(media)
        libvlc.libvlc_media_release(media)
        
        if not self.media_player:
            self.error_occurred.emit("Failed to create media player")
            return False
            
        # Set video output to our widget
        self._set_video_output()
        
        # Set initial volume
        libvlc.libvlc_audio_set_volume(self.media_player, self.current_volume)
        
        # Play
        if libvlc.libvlc_media_player_play(self.media_player) != 0:
            self.error_occurred.emit("Failed to start playback")
            return False
            
        # Start polling
        self._poll_timer.start(500)
        return True
        
    def _set_video_output(self):
        """Set video output to the embedded widget"""
        if not self.media_player or not self.video_widget:
            return
            
        # Ensure widget has a window ID
        if self.video_widget._window_id is None:
            self.video_widget._window_id = int(self.video_widget.winId())
            
        win_id = self.video_widget._window_id
        if win_id == 0:
            return
            
        if sys.platform == "linux" or sys.platform == "linux2":
            libvlc.libvlc_media_player_set_xwindow(self.media_player, ctypes.c_uint32(win_id))
        elif sys.platform == "win32":
            libvlc.libvlc_media_player_set_hwnd(self.media_player, ctypes.c_void_p(win_id))
        elif sys.platform == "darwin":
            libvlc.libvlc_media_player_set_nsobject(self.media_player, ctypes.c_void_p(win_id))
            
    def add_to_queue(self, files: List[str]):
        """Add files to queue"""
        self.queue.extend(files)
        self.queue_total = len(self.queue)
        if self.current_index == 0 and self.queue_total > 0 and not self.media_player:
            self.play_media(self.queue[0])
            
    def play_pause(self):
        if self.media_player:
            if libvlc.libvlc_media_player_is_playing(self.media_player):
                libvlc.libvlc_media_player_pause(self.media_player)
            else:
                libvlc.libvlc_media_player_play(self.media_player)
                
    def stop(self):
        if self.media_player:
            libvlc.libvlc_media_player_stop(self.media_player)
            
    def next_track(self):
        if self.current_index < self.queue_total - 1:
            self.current_index += 1
            self.play_media(self.queue[self.current_index])
            self.track_changed.emit(Path(self.queue[self.current_index]).name, 
                                    self.current_index + 1, self.queue_total)
            
    def prev_track(self):
        if self.current_index > 0:
            self.current_index -= 1
            self.play_media(self.queue[self.current_index])
            self.track_changed.emit(Path(self.queue[self.current_index]).name, 
                                    self.current_index + 1, self.queue_total)
            
    def seek(self, seconds: float):
        if self.media_player:
            libvlc.libvlc_media_player_set_time(self.media_player, int(seconds * 1000))
            
    def seek_relative(self, delta: float):
        if self.media_player:
            current = libvlc.libvlc_media_player_get_time(self.media_player)
            libvlc.libvlc_media_player_set_time(self.media_player, current + int(delta * 1000))
            
    def set_volume(self, vol: int):
        self.current_volume = max(0, min(100, vol))
        if self.media_player:
            libvlc.libvlc_audio_set_volume(self.media_player, self.current_volume)
            
    def set_mute(self, mute: bool):
        if self.media_player:
            libvlc.libvlc_audio_set_mute(self.media_player, 1 if mute else 0)
            
    def get_volume(self) -> int:
        if self.media_player:
            return libvlc.libvlc_audio_get_volume(self.media_player)
        return self.current_volume
        
    def set_scale(self, scale: float):
        if self.media_player:
            libvlc.libvlc_video_set_scale(self.media_player, scale)
            
    def set_aspect_ratio(self, ratio: str):
        if self.media_player and ratio != "Default":
            libvlc.libvlc_video_set_aspect_ratio(self.media_player, ratio.encode('utf-8'))
            
    def set_subtitle_track(self, track: int):
        if self.media_player:
            libvlc.libvlc_video_set_spu(self.media_player, track)
            
    def set_subtitle_delay(self, delay: int):
        # Not directly supported in libvlc, would need to use subtitle delay
        pass
        
    def _poll_status(self):
        """Poll media player status and emit signals"""
        if not self.media_player:
            return
            
        state = libvlc.libvlc_media_player_get_state(self.media_player)
        if state != getattr(self, '_last_state', -1):
            self._last_state = state
            self.state_changed.emit(state)
            
        current = libvlc.libvlc_media_player_get_time(self.media_player)
        total = libvlc.libvlc_media_player_get_length(self.media_player)
        if total > 0:
            self.time_changed.emit(current, total)
            
        vol = libvlc.libvlc_audio_get_volume(self.media_player)
        if vol != self.current_volume:
            self.current_volume = vol
            self.volume_changed.emit(vol)
            
        # Check if ended
        if state == libvlc_state_t.Ended:
            self._poll_timer.stop()
            if self.current_index < self.queue_total - 1:
                self.current_index += 1
                self.play_media(self.queue[self.current_index])
            else:
                self.queue_finished.emit()
                
    def cleanup(self):
        self._poll_timer.stop()
        if self.media_player:
            libvlc.libvlc_media_player_stop(self.media_player)
            libvlc.libvlc_media_player_release(self.media_player)
            self.media_player = None
        if self.instance:
            libvlc.libvlc_release(self.instance)
            self.instance = None


