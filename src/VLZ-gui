    def _on_add_files(self):
        files, _ = QFileDialog.getOpenFileNames(
            self, "Add Media Files", str(Path.home()),
            "Media Files (*.mp3 *.wav *.flac *.ogg *.m4a *.mp4 *.mkv *.avi *.webm *.mov *.ts);;All Files (*)"
        )
        if files:
            self.controller.add_to_queue(files)
            if self.controller.current_index == 0 and len(files) == 1:
                self._on_track_changed(Path(files[0]).name, 1, len(files))
            self.statusBar().showMessage(f"Added {len(files)} file(s) to queue")
            
    def _on_open_location(self):
        url, ok = QInputDialog.getText(self, "Open Location", "Enter URL:")
        if ok and url:
            self.controller.add_to_queue([url])
            self.statusBar().showMessage(f"Opening {url}")
            
    def _on_play_pause(self):
        self.controller.play_pause()
        
    def _on_stop(self):
        self.controller.stop()
        self.lbl_track.setText("Stopped")
        self.slider_time.setValue(0)
        self.lbl_time_current.setText("0:00")
        
    def _on_next(self):
        self.controller.next_track()
        
    def _on_prev(self):
        self.controller.prev_track()
        
    def _on_volume_slider(self, value: int):
        self.controller.set_volume(value)
        
    def _adjust_volume(self, delta: int):
        new_vol = max(0, min(100, self.slider_volume.value() + delta))
        self.controller.set_volume(new_vol)
        self.slider_volume.setValue(new_vol)
        
    def _on_mute_toggled(self, muted: bool):
        self.controller.set_mute(muted)
        if muted:
            self._last_volume = self.slider_volume.value()
            self.slider_volume.setValue(0)
        else:
            vol = getattr(self, '_last_volume', 50)
            self.controller.set_volume(vol)
            self.slider_volume.setValue(vol)
            
    def _on_slider_pressed(self):
        self.slider_dragging = True
        
    def _on_slider_moved(self, value: int):
        if self.slider_dragging and self.controller.media_player:
            total = libvlc.libvlc_media_player_get_length(self.controller.media_player)
            if total > 0:
                target = value / 1000 * total
                self.lbl_time_current.setText(self._fmt_time(target / 1000))
                
    def _on_slider_released(self):
        if self.controller.media_player:
            total = libvlc.libvlc_media_player_get_length(self.controller.media_player)
            if total > 0:
                target = self.slider_time.value() / 1000 * total
                self.controller.seek(target / 1000)
        self.slider_dragging = False
        
    def _on_fullscreen_toggled(self, fullscreen: bool):
        if fullscreen:
            self.showFullScreen()
        else:
            self.showNormal()
            
    def _on_fullscreen_interface(self):
        if self.isFullScreen():
            self.showNormal()
        else:
            self.showFullScreen()
            
    def _on_media_info(self):
        if self.controller.queue and self.controller.current_index >= 0:
            idx = self.controller.current_index
            if idx < len(self.controller.queue):
                path = self.controller.queue[idx]
                info = f"File: {Path(path).name}\nPath: {path}"
                QMessageBox.information(self, "Media Information", info)
        else:
            QMessageBox.information(self, "Media Information", "No media loaded.")
            
    def _on_preferences(self):
        QMessageBox.information(self, "Preferences", "Preferences dialog not implemented yet.")
        
    def _on_about(self):
        QMessageBox.about(self, "About VLZ", 
            "VLZ Media Player 0.1.0\n\n"
            "A minimal media player with embedded video.\n"
            "Built with Qt6 and Python using libvlc directly.\n\n"
            "Developed by: TryBuildMe")
            
    def _on_state_changed(self, state: int):
        if state == libvlc_state_t.Playing:
            self.btn_play.setText("⏸")
        else:
            self.btn_play.setText("▶")
        states = ["Nothing", "Opening", "Buffering", "Playing", "Paused", "Stopped", "Ended", "Error"]
        state_name = states[state] if 0 <= state < len(states) else "Unknown"
        self.statusBar().showMessage(f"State: {state_name}")
        
    def _on_time_changed(self, current: int, total: int):
        if not self.slider_dragging and total > 0:
            self.slider_time.setRange(0, 1000)
            self.slider_time.setValue(int(current / total * 1000))
        self.lbl_time_current.setText(self._fmt_time(current / 1000))
        self.lbl_time_total.setText(self._fmt_time(total / 1000))
        
    def _on_volume_changed(self, vol: int):
        self.slider_volume.blockSignals(True)
        self.slider_volume.setValue(vol)
        self.slider_volume.blockSignals(False)
        self.act_mute.setChecked(vol == 0)
        
    def _on_track_changed(self, name: str, index: int, total: int):
        self.lbl_track.setText(name)
        self.lbl_queue_pos.setText(f"Track {index} of {total}")
        
    def _on_error(self, msg: str):
        self.statusBar().showMessage(f"Error: {msg}")
        QMessageBox.warning(self, "Error", msg)
        
    def _on_queue_finished(self):
        self.lbl_track.setText("Queue finished")
        self.lbl_queue_pos.setText("")
        self.btn_play.setText("▶")
        self.statusBar().showMessage("Queue finished")
        
    def _fmt_time(self, seconds: float) -> str:
        m, s = divmod(int(seconds), 60)
        h, m = divmod(m, 60)
        if h > 0:
            return f"{h}:{m:02d}:{s:02d}"
        return f"{m}:{s:02d}"
        
    def dragEnterEvent(self, event):
        """Accept drag events with files"""
        if event.mimeData().hasUrls():
            for url in event.mimeData().urls():
                if url.isLocalFile():
                    event.acceptProposedAction()
                    return
        event.ignore()
        
    def dropEvent(self, event):
        """Handle dropped files"""
        files = []
        for url in event.mimeData().urls():
            if url.isLocalFile():
                path = url.toLocalFile()
                ext = Path(path).suffix.lower()
                if ext in {'.mp3', '.wav', '.flac', '.ogg', '.m4a', '.mp4', '.mkv', '.avi', '.webm', '.mov', '.m4v', '.3gp', '.ogv', '.ts', '.m3u', '.pls'}:
                    files.append(path)
                else:
                    files.append(path)
                    
        if files:
            self.controller.add_to_queue(files)
            if self.controller.current_index == 0 and len(files) == 1:
                self._on_track_changed(Path(files[0]).name, 1, len(files))
            self.statusBar().showMessage(f"Added {len(files)} file(s) to queue")
        event.acceptProposedAction()
        
    def closeEvent(self, event):
        self.controller.cleanup()
        event.accept()


